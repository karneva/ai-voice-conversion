    "gpu": "0",
    "cpu_cores": 8,
    "include_mutes": 2
  },
  "train": {
    "vocoder": "HiFi-GAN",
    "pretrained": "default",
    "batch_size": 8,
    "save_every_epoch": 10,
    "total_epoch": 500,
    "gpu": "0",
    "index_algorithm": "Auto",
    "checkpointing": false,
    "cache_data_in_gpu": false
  },
  "infer": {
    "grid": [
      {"f0_method": "rmvpe", "index_rate": 0.3, "protect": 0.33, "volume_envelope": 1.0}
